# Copy outside Git to the approved config root; chmod 600 the private copy.
# The selected file is authoritative. Absolute, existing roots are mandatory.
DART_CONFIG_DIR=/data/dart/config
DART_DATA_DIR=/data/dart/data
# External sources stay disabled until an administrator approves a real mount.
# Example shape (not an approved path):
# DART_SOURCE_ROOTS='[{"path":"/mnt/approved-share/collection","mount":"/mnt/approved-share"}]'
DART_SOURCE_ROOTS='[]'
# Populate ONLY in the private copy, never in Git.
DART_AZURE_CONNECTION_STRING=
